# Kopie als .envrc anlegen (ist in .gitignore). Alle Werte sind unkritische Defaults.
export APP_PORT=8080          # Port der Web-UI auf dem Host
export LAYA_PORT=8000         # Port des Laya-Servers (nur innerhalb des Compose-Netzes)
export OMP_NUM_THREADS=4      # CPU-Threads je Container, nicht über die Docker-CPU-Zahl
export GATE_THRESHOLD=0.5     # Standard-Schwellwert für die Laya-Gesamtbewertung
export LAYA_REJECT_THRESHOLD=0.9  # ab dieser Wahrscheinlichkeit für "nicht sensibel" lehnt Laya einen Treffer ab
export REQUEST_LOG=/var/log/pii-app/requests.jsonl  # Request-Log im Container, liegt auf dem Volume request-log

# Deployment (make deploy), siehe docs/deployen.md
# export DEPLOY_HOST=user@vm  # ssh-Ziel, user@host oder Alias aus ~/.ssh/config
# export DEPLOY_JUMP=user@jumphost  # optional, Jumphost wie bei ssh -J
# export DEPLOY_BIND=10.0.0.5  # Adresse, auf der die App auf der VM lauscht; 0.0.0.0 nur hinter Firewall
